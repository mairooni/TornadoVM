     }
 
+
+    // ── Regression tests: HalfFloat constructed from an ARITHMETIC float ─────
+    // expression, consumed via getHalfFloatValue() bit extraction (not an
+    // array store). Previously, TornadoHalfFloatReplacement only inserted the
+    // f32 -> f16 conversion when the constructor input was a constant or a
+    // float JavaReadNode; arbitrary float expressions (e.g. scale * quant in
+    // dequantization) fell through unconverted, producing type-mismatched
+    // code (CUDA_ERROR_INVALID_PTX (218) on the PTX backend).
+
+    public static void halfBitsFromArithmetic(KernelContext context, FloatArray a, FloatArray b, IntArray packed) {
+        int i = context.globalIdx;
+        int lo = new HalfFloat(a.get(i) * b.get(i)).getHalfFloatValue() & 0xFFFF;
+        int hi = new HalfFloat(a.get(i) + b.get(i)).getHalfFloatValue() & 0xFFFF;
+        packed.set(i, lo | (hi << 16));
+    }
+
+    public static void packDequantizedHalfBits(KernelContext context, FloatArray scales, ByteArray quants, IntArray packed) {
+        int i = context.globalIdx;
+        float v0 = scales.get(i) * quants.get(2 * i);
+        float v1 = scales.get(i) * quants.get(2 * i + 1);
+        int lo = new HalfFloat(v0).getHalfFloatValue() & 0xFFFF;
+        int hi = new HalfFloat(v1).getHalfFloatValue() & 0xFFFF;
+        packed.set(i, lo | (hi << 16));
+    }
+
+    @Test
+    public void testHalfFloatBitsFromArithmetic() throws TornadoExecutionPlanException {
+        final int size = 1024;
+        FloatArray a = new FloatArray(size);
+        FloatArray b = new FloatArray(size);
+        IntArray packed = new IntArray(size);
+
+        Random random = new Random(7);
+        for (int i = 0; i < size; i++) {
+            // Normal FP16 range, both signs, non-trivial rounding
+            a.set(i, (random.nextFloat() * 2.0f - 1.0f) * 100.0f);
+            b.set(i, (random.nextFloat() * 2.0f - 1.0f) * 100.0f);
+        }
+
+        KernelContext context = new KernelContext();
+
+        TaskGraph tg = new TaskGraph("s0")
+                .transferToDevice(DataTransferMode.EVERY_EXECUTION, a, b)
+                .task("t0", TestHalfFloats::halfBitsFromArithmetic, context, a, b, packed)
+                .transferToHost(DataTransferMode.EVERY_EXECUTION, packed);
+
+        ImmutableTaskGraph immutableTaskGraph = tg.snapshot();
+
+        WorkerGrid workerGrid = new WorkerGrid1D(size);
+        workerGrid.setLocalWork(32, 1, 1);
+        GridScheduler scheduler = new GridScheduler("s0.t0", workerGrid);
+
+        try (TornadoExecutionPlan executionPlan = new TornadoExecutionPlan(immutableTaskGraph)) {
+            executionPlan.withGridScheduler(scheduler).execute();
+        }
+
+        for (int i = 0; i < size; i++) {
+            int expectedLo = Float.floatToFloat16(a.get(i) * b.get(i)) & 0xFFFF;
+            int expectedHi = Float.floatToFloat16(a.get(i) + b.get(i)) & 0xFFFF;
+            assertEquals(expectedLo | (expectedHi << 16), packed.get(i));
+        }
+    }
+
+    @Test
+    public void testHalfFloatBitsFromDequantization() throws TornadoExecutionPlanException {
+        final int size = 1024;
+        FloatArray scales = new FloatArray(size);
+        ByteArray quants = new ByteArray(2 * size);
+        IntArray packed = new IntArray(size);
+
+        Random random = new Random(31);
+        for (int i = 0; i < size; i++) {
+            // Q8_0-like magnitudes: scale in [0.01, 0.11), int8 quants
+            scales.set(i, 0.01f + random.nextFloat() * 0.1f);
+            quants.set(2 * i, (byte) (random.nextInt(255) - 127));
+            quants.set(2 * i + 1, (byte) (random.nextInt(255) - 127));
+        }
+
+        KernelContext context = new KernelContext();
+
+        TaskGraph tg = new TaskGraph("s0")
+                .transferToDevice(DataTransferMode.EVERY_EXECUTION, scales, quants)
+                .task("t0", TestHalfFloats::packDequantizedHalfBits, context, scales, quants, packed)
+                .transferToHost(DataTransferMode.EVERY_EXECUTION, packed);
+
+        ImmutableTaskGraph immutableTaskGraph = tg.snapshot();
+
+        WorkerGrid workerGrid = new WorkerGrid1D(size);
+        workerGrid.setLocalWork(32, 1, 1);
+        GridScheduler scheduler = new GridScheduler("s0.t0", workerGrid);
+
+        try (TornadoExecutionPlan executionPlan = new TornadoExecutionPlan(immutableTaskGraph)) {
+            executionPlan.withGridScheduler(scheduler).execute();
+        }
+
+        for (int i = 0; i < size; i++) {
+            int expectedLo = Float.floatToFloat16(scales.get(i) * quants.get(2 * i)) & 0xFFFF;
+            int expectedHi = Float.floatToFloat16(scales.get(i) * quants.get(2 * i + 1)) & 0xFFFF;
+            assertEquals(expectedLo | (expectedHi << 16), packed.get(i));
+        }
+    }
