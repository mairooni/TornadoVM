@@ -146,6 +146,16 @@ public class TornadoHalfFloatReplacement extends BasePhase<TornadoHighTierContex
             OCLConvertFloatToHalf convertFloatToHalf = new OCLConvertFloatToHalf(javaReadNode);
             graph.addWithoutUnique(convertFloatToHalf);
             return convertFloatToHalf;
+        } else if (halfFloatValue.getStackKind() == JavaKind.Float) {
+            // General case: the HalfFloat is constructed from an arbitrary float
+            // expression (e.g. arithmetic such as scale * quant in dequantization).
+            // An explicit f32 -> f16 conversion must be inserted here; passing the
+            // f32 value through unconverted produces a type-mismatched half value
