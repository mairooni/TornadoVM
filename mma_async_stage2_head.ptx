        // === Check if we should issue loads for the next tile ===
        add.s32 __next_k, rsi33, 1;
        setp.lt.s32 __load_next_pred, __next_k, 128;
        @!__load_next_pred bra SKIP_LOAD;

        // === Select target buffer for the next tile's loads ===
        and.b32 __next_low, __next_k, 1;
        setp.ne.s32 __next_buf_pred, __next_low, 0;
        selp.u32 __next_a_base, __r_a1, __r_a0, __next_buf_pred;
        selp.u32 __next_b_base, __r_b1, __r_b0, __next_buf_pred;

        // === K-offsets for NEXT tile (rsi33+1) ===
        shl.b32 rsi34, __next_k, 4;       // (rsi33+1) * 16
        add.s32 rsi35, rsi34, 9;
        add.s32 rsi36, rsi34, 8;

BLOCK_3:
