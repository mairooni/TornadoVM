DO_COMPUTE:
        barrier.sync    0;
        // === ldmatrix calls now use __cur_a_base / __cur_b_base (instead of rsiArr0 / rsiArr1) ===
        .reg .b32 rmmaaf160_0, rmmaaf160_1, rmmaaf160_2, rmmaaf160_3;
